<openerp>
    <data>
        <record id="view_news_report_form" model="ir.ui.view">
            <field name="name">news.report.form</field>
            <field name="model">news.report</field>
            <field name="arch" type="xml">
                <form string="Registro de Noticias Internas">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="type_id" placeholder="Seleccionar tipo de noticia..." 
                                    options="{'no_create': False, 'no_edit': True}"/>
                            </h1>
                        </div>
                        
                        <group col="4">
                            <group string="Fechas" col="2">
                                <field name="start_date" string="Fecha Inicio" required="1"/>
                                <field name="end_date" string="Fecha Fin" required="1"/>
                            </group>
                            <group string="Responsable" col="2">
                                <field name="worker" string="Empleado" 
                                    placeholder="Seleccionar empleado..." 
                                    options="{'no_create': True}"/>
                            </group>
                        </group>
                        
                        <group string="Descripción de la Noticia">
                            <field name="report_description" 
                                placeholder="Describa detalladamente la noticia o novedad..."
                                nolabel="1" 
                                colspan="4"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</openerp>
