<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="new_form_view" model="ir.ui.view">
            <field name="name">new.form_view</field>
            <field name="model">odoo8_module_news_distefano.new</field>
            <field name="arch" type="xml">
                <form string="Noticia de empleado / RRHH">
                    <sheet>
                        <group>
                            <field name="type_id" string="Tipo"/>
                            <field name="start_date" string="Fecha inicio"/>
                            <field name="end_date" string="Fecha finalizacion"/>
                        </group>
                        <group>
                            <field name="type_id" string="Tipo"/>
                            <field name="employee_id" string="Empleado"/>
                            <field name="employee_id.department_id" string="Departamento" readonly="1"/>
                        </group>
                        <group>
                            <field name="description" string="Descripcion" placeholder="Informacion adicional..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</openerp>
