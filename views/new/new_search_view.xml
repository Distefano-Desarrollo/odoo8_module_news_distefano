<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="new_search_view" model="ir.ui.view">
            <field name="name">new.search_view</field>
            <field name="model">odoo8_module_news_distefano.new</field>
            <field name="arch" type="xml">
                <search string="Buscar Noticia">
                    <field name="employee_id" string="Empleado"/>
                    <field name="type_id" string="Tipo"/>

                    <group expand="0" string="Agrupar Por">
                        <filter string="Empleado" context="{'group_by':'employee_id'}"/>
                        <filter string="Tipo de Noticia" context="{'group_by':'type_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</openerp>