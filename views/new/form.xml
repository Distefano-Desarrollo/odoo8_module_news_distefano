<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="view_news_report_form" model="ir.ui.view">
            <field name="name">news.report.form</field>
            <field name="model">news.report</field>
            <field name="arch" type="xml">
                <form string="Noticia Interna">
                <sheet>
                    <group>
                    <field name="type_id"/>
                    <field name="worker"/>
                    </group>
                    <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    </group>
                    <group>
                    <field name="report_description" colspan="4"/>
                    </group>
                </sheet>
                </form>
            </field>
        </record>
    </data>
</openerp>